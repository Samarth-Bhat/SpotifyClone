package com.music.services;

import org.springframework.stereotype.Service;
import org.springframework.web.multipart.MultipartFile;

import java.io.IOException;
import java.io.InputStream;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.Paths;

@Service
public class StorageService {

    private final Path storageLocation = Paths.get("path/to/your/storage/location");

    public StorageService() {
        try {
            if (!Files.exists(storageLocation)) {
                Files.createDirectories(storageLocation);
            }
        } catch (IOException e) {
            throw new RuntimeException("Could not initialize storage location", e);
        }
    }

    public void uploadSong(MultipartFile file) throws IOException {
        if (file.isEmpty()) {
            throw new IOException("Cannot upload an empty file");
        }

        Path targetLocation = storageLocation.resolve(file.getOriginalFilename());

        try (InputStream inputStream = file.getInputStream()) {
            Files.copy(inputStream, targetLocation);
        } catch (IOException e) {
            throw new IOException("Failed to store file " + file.getOriginalFilename(), e);
        }
    }

    public void deleteSong(String fileName) throws IOException {
        Path fileToDelete = storageLocation.resolve(fileName);
        Files.deleteIfExists(fileToDelete);
    }

    public InputStream loadSongAsStream(String fileName) throws IOException {
        Path fileToLoad = storageLocation.resolve(fileName);
        return Files.newInputStream(fileToLoad);
    }
}
